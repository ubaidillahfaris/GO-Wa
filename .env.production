# ==============================================
# Production Environment Configuration
# ==============================================
# Copy this file to .env.production and update with your production values

# ----------------------------------------------
# SERVER CONFIGURATION
# ----------------------------------------------
PORT=3000
ENVIRONMENT=production

# ----------------------------------------------
# MONGODB CONFIGURATION
# ----------------------------------------------
MONGO_USER=admin_whatsapp
MONGO_PASS=CHANGE_THIS_STRONG_PASSWORD_123!
MONGO_HOST=mongo:27017
MONGO_PORT=27017
MONGO_DB=whatsapp_production

# ----------------------------------------------
# JWT AUTHENTICATION
# ----------------------------------------------
# Generate strong secret: openssl rand -base64 64
JWT_SECRET=CHANGE_THIS_TO_VERY_LONG_RANDOM_STRING_USE_OPENSSL_RAND
JWT_EXPIRES_MIN=60

# ----------------------------------------------
# WHATSAPP CONFIGURATION
# ----------------------------------------------
WHATSAPP_STORES_DIR=./stores
WHATSAPP_UPLOADS_DIR=./uploads/whatsapp
WHATSAPP_MAX_CONCURRENCY=20

# ----------------------------------------------
# CORS CONFIGURATION
# ----------------------------------------------
# Set your production frontend URL
CORS_ALLOWED_ORIGIN=https://yourdomain.com
CORS_MAX_AGE=43200

# ----------------------------------------------
# NGINX/PROXY CONFIGURATION
# ----------------------------------------------
HTTP_PORT=80
HTTPS_PORT=443

# ----------------------------------------------
# FRONTEND CONFIGURATION
# ----------------------------------------------
VITE_API_BASE_URL=/api

# ----------------------------------------------
# DOCKER COMPOSE
# ----------------------------------------------
COMPOSE_PROJECT_NAME=whatsapp-production
